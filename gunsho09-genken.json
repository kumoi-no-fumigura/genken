 "poems": [
  {
   "seq": "1",
   "text": "小山田の水のこほりのうちとけて今朝は蛙もゆるに鳴なり",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "春日野のゝへの霞に立ましり志るも志らぬも若菜つむらし",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "みなかみの岩間の氷とけぬらむゐせきの〓水こゑまさるなり",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "ゆきすりに梅かかきねに立寄てそらたき物を身にふたみ哉",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "去年といひ今年といへと我は只きのふけふとも思ほゆるかな",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "夜もあけはあしたの原に立出て雪のきえまに若なつみてん",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "いつのまにわき葉さしけく今朝も又雪降つめるのへの若きに",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "さもあらはあれ人はみす共花の木は風隱れにそうふへかりける",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "春くれは木のもと〓との櫻花はなのふちともみえ渡る哉",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "櫻花みきはゑらゝに散つもりあまもひろはぬかひかとそ見る",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "むらさきのむらこの糸を染かけて風に波よる岸の藤なみ",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "ゆく春のゐせきにとまる物ならは先おりたちて我そせかまし",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "山路にて初音はきゝつ時鳥わいふる里にはやくなれなん",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "鳴出る山時鳥人ならはよきとつてのたよりならまし",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "さ夜中のたき木の煙立そひてはやしのかすみひまなかりけり",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "一聲にあけぬるものをほとゝきすさよ更るまて何またすらん",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あさましくみしかき夜かな時鳥二こゑとたにえやは鳴ける",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "あらてたに伏かとすれは明る夜を何をあかすとたゝく水鷄そ",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "いかはかり歎をつめる身なれはかよをへてもゆる螢成らむ",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "我宿におほしたてたる花なれとふたはの心またふらぬかな",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "たよせにやけふはかさまし七夕の空にたなひくさゝかにの糸",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "河風や身にさむからんさ夜中にねくらさためめ千鳥鳴なり",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "山のはにいりなんとせし月影をあはれ有明とみるそうれしき",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "ふりかけしねくたれ髪をかき探り人たかへたる心ちもやせん",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "をとにのみきゝ渡りにし天のかは旅の空にてけふみつる哉",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "名にしおはゝあたなやたゝん女郞花咲亂れたるのへに積りて",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "雲をへてみゝなれにたる山ふしも夢さめぬへき鹿のこゑかな",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "み山には嵐吹けりたきつせの水せくはかり紅葉つもれる",
   "kana": "",
   "speaker": "源賢法眼集",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "年月の過にしかたを尋ぬれは我身につもる物にさりけろ",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "たむくとも手向の神やうけさらん紅葉のにし〓〔本ノマ、〕",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "みなそこにうつれる秋の山かけはかゝみのはこの錦とそみる",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "やすきいもねられさり鳬紅葉ちる夜半の嵐のうしろめたさに",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "秋はたゝけふはかりそとなかむれは夕暮にさへ成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "いかてかは老せぬものといひをきし霜いたゝけるゑら菊の花",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "をし鳥のはねも氷にとちてけり霜うちはらふ音たにもせす",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "みこもりていてむよもなき沼水のいや氷ゆく冬そかなしき",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "紅葉〓をわかこゝろとは散すともよその嵐にまかせてはみし",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "なにをかもなくさめにせん冬山のふりつむ雪のとくる待間に",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "うつろふにふかさまされる菊花たれ秋はつるいろといひ劔",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "すみよしの天くたりけむ其の神のあはれ相生の松をしそ思",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "音たえていかにとたにもいはぬまの水を深くも賴みけるかな",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "我かとのほかなる車めくらさん法あらさらむ人のさとまて",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "むすほゝる蓮の糸をとかれすは葉末のいかて亂れさらまし",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "露の身は草葉にのみかおいぬれはつえにもかゝる物にさり鳬",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "御狩野にあさたつきしのほろ〓〓と鳴つゝそふる身を恨つゝ",
   "kana": "",
   "speaker": "",
   "page": 552,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "すみすます人知らめや程遠み鳥のかけたにみえぬ山みつ",
   "kana": "",
   "speaker": "夢想國師御詠草",
   "page": 553,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "おもひきや我ふめゆひし撫子を人のまかきの花とみんとは",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "跡たえて人もかよはぬ山里のなによもすから呼子鳥そも",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "葉をゑけみ山邊にかゝる露の身をゝき所なき世にもふる哉",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "さゝれ石の上行水のあさましくさら〓〓さらにとはぬ君哉",
   "kana": "",
   "speaker": "",
   "page": 553,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
